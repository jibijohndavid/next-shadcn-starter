{
  "name": "next-shadcn-tailwind",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:debug": "NODE_OPTIONS='--inspect' next dev --turbopack",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "build:debug": "next build --debug",
    "start": "next start",
    "start:prod": "NODE_ENV=production next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "lint:strict": "next lint --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "check-all": "pnpm type-check && pnpm lint && pnpm format:check",
    "fix-all": "pnpm lint:fix && pnpm format",
    "test": "echo 'No tests specified' && exit 0",
    "test:watch": "echo 'No tests specified' && exit 0",
    "clean": "rm -rf .next && rm -rf node_modules/.cache && rm -rf .turbo",
    "clean:all": "pnpm clean && rm -rf node_modules && pnpm install",
    "analyze": "pnpm build:analyze",
    "preview": "pnpm build && pnpm start",
    "health-check": "pnpm type-check && pnpm lint:strict && pnpm format:check --ignore-path .prettierignore && pnpm build",
    "perf:build": "time pnpm build",
    "perf:type-check": "time pnpm type-check",
    "perf:dev": "NODE_OPTIONS='--max-old-space-size=4096' pnpm dev",
    "optimize": "pnpm clean && pnpm install && pnpm build:analyze",
    "bundle-size": "pnpm build && npx bundlesize",
    "postinstall": "echo 'Dependencies installed successfully with PNPM'"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "next": "15.4.1",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^15.4.1",
    "@tailwindcss/postcss": "^4",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "autoprefixer": "^10.4.21",
    "bundlesize": "^0.18.2",
    "cssnano": "^7.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.4.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  }
}
