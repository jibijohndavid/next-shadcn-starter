{
  "files": [
    {
      "path": ".next/static/chunks/*.js",
      "maxSize": "200kb",
      "compression": "gzip"
    },
    {
      "path": ".next/static/css/*.css",
      "maxSize": "50kb",
      "compression": "gzip"
    },
    {
      "path": ".next/app/**/*.js",
      "maxSize": "100kb",
      "compression": "gzip"
    }
  ],
  "defaultCompression": "gzip"
}
