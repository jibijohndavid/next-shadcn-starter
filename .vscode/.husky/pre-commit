#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# Run type checking first (fast fail)
echo "📝 Type checking..."
pnpm type-check

# Run lint-staged for staged files
echo "🧹 Linting and formatting staged files..."
npx lint-staged

echo "✅ Pre-commit checks passed!"
