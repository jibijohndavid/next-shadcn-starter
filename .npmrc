# PNPM Configuration
# This file configures PNPM behavior for optimal development experience

# Use strict peer dependencies to catch version conflicts early
strict-peer-dependencies=true

# Automatically install peer dependencies
auto-install-peers=true

# Use shamefully-hoist for better compatibility with tools that expect flat node_modules
shamefully-hoist=false

# Enable better error messages
prefer-frozen-lockfile=false

# Store configuration
store-dir=~/.pnpm-store

# Registry configuration (use default npm registry)
registry=https://registry.npmjs.org/

# Enable progress reporting
progress=true

# Dedupe packages to save space
dedupe-peer-dependents=true

# Save exact versions for better reproducibility
save-exact=false

# Enable package-import-method for better performance
package-import-method=auto